{
  "applicationId": "local.n0va.wallpapergui",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "os.execCommand",
    "os.showOpenDialog",
    "os.showFolderDialog"
  ],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "N0va 壁纸助手",
      "width": 620,
      "height": 640,
      "minWidth": 560,
      "minHeight": 560,
      "center": true,
      "exitProcessOnClose": true,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png"
    }
  },
  "cli": {
    "binaryName": "n0va-wallpaper-gui",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.0.0",
    "clientVersion": "6.9.0"
  },
  "enableServer": true,
  "enableNativeAPI": true,
  "documentRoot": "/resources/"
}